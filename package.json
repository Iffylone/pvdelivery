{
  "name": "pvdelivery",
  "version": "1.1.0",
  "description": "Iffyware Systems — PVDelivery multi-tenant",
  "main": "electron/main.js",
  "scripts": {
    "start": "node servidor.js",
    "dev": "node --watch servidor.js",
    "electron": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "mercadopago": "^2.3.0",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^7.2.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.iffyware.pvdelivery",
    "productName": "PVDelivery",
    "files": ["servidor.js", "auth.js", "pvdelivery.html", "public/**/*", "electron/**/*", "node_modules/**/*"],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
