# ============================================================
# IFFYWARE SYSTEMS — Variables de entorno
# Copiar este archivo a .env y completar los valores reales
# En Railway: ir a Variables > Raw Editor y pegar estas claves
# ============================================================

# Base de datos (Railway provee esto automáticamente si agregás PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# URL pública del servidor (tu dominio en Railway, sin barra final)
BASE_URL=https://delivery-production.up.railway.app

# ── MERCADO PAGO ─────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
# Credenciales de PRUEBA (sandbox): el Access Token empieza con TEST-
# Credenciales de PRODUCCIÓN: empieza con APP_USR-
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Tarjetas de prueba para sandbox MP:
# Visa aprobada:    4509 9535 6623 3704 | CVV: 123 | Vto: 11/25
# Master aprobada:  5031 7557 3453 0604 | CVV: 123 | Vto: 11/25
# Visa rechazada:   4170 0688 1010 8020 | CVV: 123 | Vto: 11/25
# DNI del pagador de prueba: 12345678
# Email del pagador de prueba: test_user_123456@testuser.com

# ── MODO ─────────────────────────────────────────────────────
# Obtener en: https://developers.modo.com.ar
# En sandbox no se debita dinero real
MODO_API_KEY=sandbox_xxxxxxxxxxxxxxxx
MODO_SECRET=xxxxxxxxxxxxxxxx

# Puerto (Railway lo setea automáticamente, no tocar)
# PORT=3000
