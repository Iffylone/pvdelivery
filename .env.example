# ══════════════════════════════════════════════════════════════
# PVDelivery — Variables de entorno por cliente
# Copiá este archivo como .env para desarrollo local.
# En producción (Railway / Render) cargá estas variables
# directamente en el panel de cada servicio.
# ══════════════════════════════════════════════════════════════

# ── Identidad del local ────────────────────────────────────────
# Nombre que aparece en la app y en los tickets
NEGOCIO=Mi Negocio

# Código corto único del local (se genera automáticamente si no se define)
# Útil para fijarlo en producción y que no cambie entre reinicios
CODIGO_LOCAL=

# Dirección visible en la app
DIR_LOCAL=Av. Siempreviva 742, Springfield

# CBU / CVU para cobros por QR interoperable (Personal Pay, Uala, Naranja X, BNA+)
CBU_LOCAL=0000003100012345678901
ALIAS_LOCAL=MI.NEGOCIO.MP

# ── Seguridad ──────────────────────────────────────────────────
# JWT_SECRET: obligatoria en producción. Sin ella, el servidor genera una
# temporal en cada arranque y todas las sesiones se cierran al reiniciar.
# Generarla una vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-una-cadena-aleatoria-larga-y-unica

# Clave de 4 dígitos para operadores (caja)
CLAVE_OPERADOR=1234

# Clave de 4 dígitos para administrador
CLAVE_ADMIN=9999

# Opcional — habilita que el APK Android abra sin barra del navegador.
# Se completa DESPUÉS de generar el instalador Android (ver README-instaladores.md)
# ANDROID_ASSETLINKS_JSON=[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"...","sha256_cert_fingerprints":["..."]}}]

# ── Comisiones de repartidores ─────────────────────────────────
# Tipo: "por_km" o "fija"
COMISION_TIPO=por_km

# Si COMISION_TIPO=por_km: pesos por metro recorrido
COMISION_POR_METRO=0.60

# Si COMISION_TIPO=fija: monto fijo por entrega
COMISION_FIJA=0

# ── Base de datos ──────────────────────────────────────────────
# Sin esta variable el sistema corre en RAM (datos se pierden al reiniciar)
# Con PostgreSQL (Railway / Render add-on / Supabase):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ── Mercado Pago ───────────────────────────────────────────────
# Credenciales de PRUEBA (sandbox): empiezan con TEST-
# Credenciales de PRODUCCIÓN: empiezan con APP_USR-
# Obtenerlas en: mercadopago.com.ar/developers → tu app → Credenciales
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── MODO (billetera de bancos) ─────────────────────────────────
# Requiere onboarding comercial en https://modo.com.ar/empresas
MODO_CLIENT_ID=
MODO_CLIENT_SECRET=

# ── Stripe (pagos internacionales, opcional) ───────────────────
# Sandbox gratuito en https://stripe.com/docs/testing
STRIPE_SECRET_KEY=sk_test_...

# ── Productos por defecto (opcional) ──────────────────────────
# JSON array con los productos que aparecen al iniciar por primera vez.
# Si no se define, se usa la lista genérica del código.
# Formato: [{"id":1,"nombre":"Producto","precio":1000,"categoria":"principal","descripcion":"","imagen":null}]
PRODUCTOS_DEFAULT=

# ── Servidor ───────────────────────────────────────────────────
# Railway y Render lo asignan automáticamente. Solo definirlo en local si querés cambiar el puerto.
PORT=3000
